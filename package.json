{
  "name": "mta-api",
  "bin": {
    "mta-mcp": "src/mcp/stdio.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp/stdio.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "openapi:dump": "DB_PATH=:memory: bun run scripts/openapi.ts",
    "seed": "bun run scripts/seed.ts",
    "lint": "oxlint src/ scripts/",
    "lint:fix": "oxlint --fix src/ scripts/",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:hurl": "sh scripts/hurl.sh test/e2e/contract.hurl test/e2e/stops.hurl test/e2e/schedule.hurl",
    "test:hurl:all": "sh scripts/hurl.sh test/e2e/contract.hurl test/e2e/stops.hurl test/e2e/schedule.hurl test/e2e/realtime.hurl"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "hono-pino": "^0.10.3",
    "papaparse": "^5.7.0",
    "pino": "^10.4.0",
    "protobufjs": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/papaparse": "^5.5.2",
    "@types/swagger-ui-dist": "^3.30.6",
    "oxlint": "^1.88.0",
    "pino-pretty": "^13.2.0",
    "swagger-ui-dist": "^5.33.2",
    "typescript": "5.9.3"
  }
}